   Name = "Auto refresh FPS cap stats",
   CurrentValue = false,
   Flag = "Toggle1", -- A flag is the identifier for the configuration file, make sure every element has a different flag if you're using configuration saving to ensure no overlaps
   Callback = function(Value)
   running = Value
        task.spawn(function()
            while running do
                Label:Set("FPS cap: " .. getfpscap(), 4483362458, Color3.fromRGB(40, 40, 40), false) -- Title, Icon, Color, IgnoreTheme
